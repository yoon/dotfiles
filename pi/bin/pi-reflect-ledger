#!/usr/bin/env bash
# pi-reflect-ledger — compact event ledger of one pi session JSONL.
# Prints every user turn (truncated), every tool call with truncated args,
# and compaction markers. Complements pi-reflect-stats (quantitative) and
# pi-reflect-transcript (full text, may exceed output caps on long sessions).
# Usage: pi-reflect-ledger [--errors] [SESSION]
#   --errors = group failed tool calls by tool and originating user turn
#   SESSION  = path to .jsonl | partial session id | (omitted → newest session for $PWD)
set -euo pipefail
root=~/.pi/agent/sessions
errors_only=false
session=""
for arg in "$@"; do
  case "$arg" in
    --errors) errors_only=true ;;
    -*) echo "unknown option: $arg" >&2; exit 2 ;;
    *) [[ -z "$session" ]] || { echo "accepts at most one session" >&2; exit 2; }; session="$arg" ;;
  esac
done

newest_all() {
  find "$root" -name "*.jsonl" -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1
}

key_for_path() {
  local p="${1#/}"
  p="${p//\//-}"
  printf '%s' "--$p--"
}

resolve() {
  local arg="${1:-}"
  if [[ -n "$arg" && -f "$arg" ]]; then echo "$arg"; return; fi
  if [[ -n "$arg" ]]; then
    find "$root" -name "*$arg*.jsonl" -print0 2>/dev/null \
      | xargs -0 ls -t 2>/dev/null | head -1; return
  fi

  local key hit
  key="$(key_for_path "$PWD")"
  hit="$(ls -t "$root/$key"/*.jsonl 2>/dev/null | head -1 || true)"
  [[ -n "$hit" ]] && { echo "$hit"; return; }

  newest_all
}

f="$(resolve "$session")"
[[ -n "$f" && -f "$f" ]] || { echo "no session file found (arg: '$session')" >&2; exit 1; }
echo "session_file: $f"

python3 - "$f" "$errors_only" <<'EOF'
import json, sys
from collections import Counter

USER_W, ARG_W = 160, 110
errors_only = sys.argv[2] == "true"
n = 0
calls = {}
errors = Counter()
previews = {}
for line in open(sys.argv[1]):
    try:
        e = json.loads(line)
    except json.JSONDecodeError:
        continue
    t = e.get("type")
    if t == "compaction":
        if not errors_only:
            print("=== COMPACTION ===")
        continue
    if t != "message":
        continue
    m = e.get("message", {})
    role = m.get("role")
    c = m.get("content")
    if role == "user":
        txt = c if isinstance(c, str) else " ".join(
            x.get("text", "") for x in (c or [])
            if isinstance(x, dict) and x.get("type") == "text"
        )
        if txt.strip():
            n += 1
            if not errors_only:
                print(f"--- USER {n}: {txt[:USER_W]!r}")
    elif role == "assistant" and isinstance(c, list):
        for x in c:
            if x.get("type") in ("toolCall", "tool_use"):
                name = x.get("name") or x.get("toolName")
                args = json.dumps(x.get("input") or x.get("arguments") or {})[:ARG_W]
                calls[x.get("id")] = (name, n)
                if not errors_only:
                    print(f"  TOOL {name} {args}")
    elif role == "toolResult" and m.get("isError"):
        body = " ".join(
            x.get("text", "") for x in (c or [])
            if isinstance(x, dict) and x.get("type") == "text"
        )
        name, turn = calls.get(m.get("toolCallId"), (m.get("toolName") or "?", n))
        preview = " ".join(body.split())[:160]
        errors[(name, turn)] += 1
        previews.setdefault((name, turn), preview)
        if not errors_only:
            print(f"  ERROR {name} {preview!r}")

if errors_only:
    print(f"tool_errors: {sum(errors.values())}")
    for (name, turn), count in sorted(errors.items(), key=lambda item: (-item[1], item[0])):
        print(f"  {count:3}  USER {turn:<3}  {name:<28} {previews[(name, turn)]!r}")
EOF
